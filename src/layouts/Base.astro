---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonicalPath?: string;
  publishedTime?: string;
  tags?: string[];
}

const {
  title,
  description = 'ফোন ঘাঁটাঘাঁটির নোটবুক — বাংলায় Android টিংকারিং: Shizuku, Canta, ADB, DNS',
  image = '/og-image.png',
  type = 'website',
  canonicalPath = Astro.url.pathname,
  publishedTime,
  tags = [],
} = Astro.props;

const site = 'https://asim-lab.vercel.app';
const fullTitle = `${title} — Asim's Lab`;
const canonical = new URL(canonicalPath, site).href;
const ogImage = new URL(image, site).href;
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0d1117" />
    <meta name="author" content="Asim Kumar" />
    <meta name="google-site-verification" content="c0911OsBmAtmd5bgaTv_PFrcQurEnwmcNBhDPBUqcP4" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Asim's Lab" />
    <meta property="og:locale" content="bn_BD" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Asim's Lab — ফোন ঘাঁটাঘাঁটির নোটবুক" />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && tags.map((t) => (
      <meta property="article:tag" content={t} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- RSS autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title="Asim's Lab — RSS" href="/rss.xml" />

    <!-- Self-hosted fonts: preload the weights used above the fold (latin for the H1, bengali for body) -->
    <link rel="preload" href="/fonts/hind-siliguri-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hind-siliguri-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hind-siliguri-700-bengali.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hind-siliguri-400-bengali.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#070b12" />

    <!-- Structured data: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: "Asim's Lab",
      alternateName: 'Asim4998',
      url: site,
      inLanguage: 'bn',
      description: 'ফোন ঘাঁটাঘাঁটির নোটবুক — বাংলায় Android টিংকারিং',
      publisher: {
        '@type': 'Organization',
        name: "Asim's Lab",
        url: site,
        logo: `${site}/logo.svg`,
      },
    })} />
  </head>
  <body>
    <div class="read-progress" aria-hidden="true"><div class="bar"></div></div>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><img src="/logo.svg" alt="Asim's Lab লোগো" width="28" height="28" />asim-lab</a>
        <nav class="nav" aria-label="প্রধান মেনু">
          <a href="/" class={current === '/' ? 'active' : ''}>হোম</a>
          <a href="/blog" class={current.startsWith('/blog') ? 'active' : ''}>ব্লগ</a>
          <a href="/tags" class={current.startsWith('/tags') ? 'active' : ''}>ট্যাগ</a>
          <a href="/about" class={current === '/about' ? 'active' : ''}>পরিচিতি</a>
          <a href="/search" class={current === '/search' ? 'active' : ''} aria-label="সার্চ">🔍</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© ২০২৬ Asim4998 · ফোন ঘাঁটাঘাঁটির নোটবুক</span>
        <nav aria-label="ফুটার">
          <a href="/search">সার্চ</a>
          <a href="/tags">ট্যাগ</a>
          <a href="/rss.xml">RSS</a>
          <a href="/about">পরিচিতি</a>
          <a href="/contact">যোগাযোগ</a>
          <a href="/privacy">প্রাইভেসি</a>
          <a href="/terms">শর্তাবলী</a>
        </nav>
      </div>
    </footer>

    <button class="to-top" id="toTop" aria-label="উপরে যাও">↑</button>

    <script>
      // reading progress + back-to-top + scroll reveal (tiny, no framework)
      const bar = document.querySelector('.read-progress .bar');
      const toTop = document.getElementById('toTop');
      const onScroll = () => {
        const h = document.documentElement;
        const p = h.scrollTop / (h.scrollHeight - h.clientHeight || 1);
        if (bar) bar.style.transform = `scaleX(${p})`;
        if (toTop) toTop.classList.toggle('show', h.scrollTop > 600);
      };
      document.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      toTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.08 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
