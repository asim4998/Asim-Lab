---
interface Props {
  slug: string;
  title: string;
  description?: string;
  date: string;
  reading?: string;
  tags?: string[];
  image?: string;
}
const { slug, title, description, date, reading, tags = [], image } = Astro.props;
---

<li class="post-card reveal has-thumb">
  {image ? (
    <a class="thumb-wrap" href={`/blog/${slug}`} tabindex="-1" aria-hidden="true">
      <img src={image} alt="" loading="lazy" decoding="async" />
    </a>
  ) : (
    <div class="thumb-wrap" aria-hidden="true"><span class="fallback-emoji">🧪</span></div>
  )}
  <div class="card-body">
    <a class="title" href={`/blog/${slug}`}>{title}</a>
    {description && <p class="desc">{description}</p>}
    <div class="meta">
      <span>{date}</span>
      {reading && <span class="reading">📖 {reading}</span>}
      {tags.slice(0, 3).map((t) => <a class="tag" href={`/tags/${t}`}>#{t}</a>)}
    </div>
  </div>
</li>
