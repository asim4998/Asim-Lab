---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('bn-BD', { year: 'numeric', month: 'long', day: 'numeric' });

const reading = (body: string) =>
  `${Math.max(1, Math.round(body.split(/\s+/).length / 200))} মিনিট`;
---

<Base title="ব্লগ" description="Asim's Lab-এর সব পোস্ট — Android টিংকারিং নোট">
  <div class="wrap">
    <section class="hero" style="padding-bottom:0.5rem">
      <p class="kicker">$ ls ./posts</p>
      <h1>ব্লগ 📝</h1>
      <p class="tagline">ল্যাব নোটবুকের সব পাতা — নতুন থেকে পুরনো।</p>
    </section>

    <ul class="post-list">
      {posts.map((p) => (
        <PostCard
          slug={p.id.replace(/\.md$/, '')}
          title={p.data.title}
          description={p.data.description}
          date={fmt(p.data.pubDate)}
          reading={reading(p.body)}
          tags={p.data.tags ?? []}
          image={p.data.image}
        />
      ))}
    </ul>
  </div>
</Base>
