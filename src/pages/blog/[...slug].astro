---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id.replace(/\.md$/, '') }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const slug = post.id.replace(/\.md$/, '');

const fmt = (d: Date) =>
  d.toLocaleDateString('bn-BD', { year: 'numeric', month: 'long', day: 'numeric' });

const site = 'https://asim-lab.vercel.app';
const url = `${site}/blog/${slug}`;

const allPosts = await getCollection('blog');
const related = allPosts
  .filter((p) => p.id !== post.id && (p.data.tags ?? []).some((t) => (post.data.tags ?? []).includes(t)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  inLanguage: 'bn',
  url,
  author: { '@type': 'Person', name: 'Asim Kumar' },
  publisher: {
    '@type': 'Organization',
    name: "Asim's Lab",
    url: site,
  },
  keywords: (post.data.tags ?? []).join(', '),
};
---

<Base
  title={post.data.title}
  description={post.data.description ?? post.data.title}
  type="article"
  canonicalPath={`/blog/${slug}`}
  publishedTime={post.data.pubDate.toISOString()}
  tags={post.data.tags ?? []}
>
  <div class="wrap">
    <article class="article">
      <h1>{post.data.title}</h1>
      <div class="meta">
        <span>{fmt(post.data.pubDate)}</span>
        {post.data.tags.map((t) => <span class="tag">#{t}</span>)}
      </div>
      <div class="prose">
        <Content />
      </div>
      {related.length > 0 && (
        <section class="related">
          <h2>আরও পড়ো 📚</h2>
          <ul class="post-list">
            {related.map((p) => (
              <li class="post-card">
                <a class="title" href={`/blog/${p.id.replace(/\.md$/, '')}`}>{p.data.title}</a>
                {p.data.description && <p class="desc">{p.data.description}</p>}
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
</Base>
