---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id.replace(/\.md$/, '') }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const slug = post.id.replace(/\.md$/, '');

const fmt = (d: Date) =>
  d.toLocaleDateString('bn-BD', { year: 'numeric', month: 'long', day: 'numeric' });

const words = post.body.split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 200));

// table of contents from ## / ### headings
const slugify = (s: string) =>
  s.toLowerCase().replace(/[^\p{L}\p{M}\p{N}\s-]/gu, '').trim().replace(/[\s_]+/g, '-').slice(0, 60) || 'section';
const toc = [...post.body.matchAll(/^#{2,3}\s+(.+)$/gm)].map((m) => ({
  level: m[0].startsWith('###') ? 3 : 2,
  text: m[1].trim(),
  id: slugify(m[1].trim()),
}));

const site = 'https://asim-lab.vercel.app';
const url = `${site}/blog/${slug}`;

const allPosts = await getCollection('blog');
const related = allPosts
  .filter((p) => p.id !== post.id && (p.data.tags ?? []).some((t) => (post.data.tags ?? []).includes(t)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  inLanguage: 'bn',
  url,
  author: { '@type': 'Person', name: 'Asim Kumar' },
  publisher: { '@type': 'Organization', name: "Asim's Lab", url: site },
  keywords: (post.data.tags ?? []).join(', '),
};
---

<Base
  title={post.data.title}
  description={post.data.description ?? post.data.title}
  type="article"
  canonicalPath={`/blog/${slug}`}
  publishedTime={post.data.pubDate.toISOString()}
  tags={post.data.tags ?? []}
>
  <div class="wrap">
    <article class="article">
      <h1>{post.data.title}</h1>
      <div class="meta">
        <span>{fmt(post.data.pubDate)}</span>
        <span class="reading">📖 {minutes} মিনিটে পড়ো</span>
        {(post.data.tags ?? []).map((t) => <a class="tag" href={`/tags/${t}`}>#{t}</a>)}
      </div>

      {toc.length > 1 && (
        <nav class="toc" aria-label="সূচিপত্র">
          <p>📑 সূচিপত্র</p>
          <ul>
            {toc.map((h) => (
              <li class={h.level === 3 ? 'lv3' : ''}><a href={`#${h.id}`}>{h.text}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <div class="prose">
        <Content />
      </div>

      <section class="about-teaser reveal" style="margin-top:2.5rem">
        <h2>✍️ লেখক: Asim4998</h2>
        <p>
          আমি আসিম — শুধু ফোন দিয়েই Android ঘাঁটাঘাঁটি করি। এই পোস্টের
          সমাধানগুলো যাচাই করে এখানে লিখে রাখি। কিছু কাজ না করলে
          <a href="/contact">জানাও</a>, ঠিক করে দেবো।
        </p>
      </section>

      {related.length > 0 && (
        <section class="related">
          <h2 class="section-title">আরও পড়ো</h2>
          <ul class="post-list">
            {related.map((p) => (
              <PostCard
                slug={p.id.replace(/\.md$/, '')}
                title={p.data.title}
                description={p.data.description}
                date={fmt(p.data.pubDate)}
                tags={p.data.tags ?? []}
                image={p.data.image}
              />
            ))}
          </ul>
        </section>
      )}
    </article>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
</Base>
