---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id.replace(/\.md$/, '') }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('bn-BD', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={post.data.title} description={post.data.description ?? post.data.title}>
  <div class="wrap">
    <article class="article">
      <h1>{post.data.title}</h1>
      <div class="meta">
        <span>{fmt(post.data.pubDate)}</span>
        {post.data.tags.map((t) => <span class="tag">#{t}</span>)}
      </div>
      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</Base>
