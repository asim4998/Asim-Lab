---
import Base from '../layouts/Base.astro';
---

<Base title="সার্চ" description="Asim's Lab-এ পোস্ট খোঁজো">
  <div class="wrap">
    <section class="hero" style="padding-bottom:0.5rem">
      <p class="kicker">$ grep -r</p>
      <h1>সার্চ 🔍</h1>
      <p class="tagline">ল্যাবের সব পোস্টে খোঁজো — শিরোনাম, ট্যাগ বা লেখার ভেতর।</p>
    </section>

    <div class="search-box">
      <span class="icon">🔍</span>
      <input id="q" type="search" placeholder="যেমন: shizuku, ব্যাটারি, api…" autocomplete="off" />
    </div>
    <p class="search-hint" id="hint">টাইপ করলেই ফলাফল আসবে…</p>
    <ul class="post-list search-results" id="results"></ul>
  </div>

  <script>
    const q = document.getElementById('q');
    const results = document.getElementById('results');
    const hint = document.getElementById('hint');
    let index = [];
    fetch('/search-index.json').then((r) => r.json()).then((d) => { index = d; });

    q.addEventListener('input', () => {
      const term = q.value.trim().toLowerCase();
      if (term.length < 2) {
        results.innerHTML = '';
        hint.textContent = 'টাইপ করলেই ফলাফল আসবে…';
        return;
      }
      const hits = index.filter((p) =>
        (p.title + ' ' + p.description + ' ' + p.tags.join(' ') + ' ' + p.text)
          .toLowerCase().includes(term)
      ).slice(0, 20);
      hint.textContent = hits.length ? `${hits.length}টা পোস্ট পাওয়া গেছে` : 'কিছু পাওয়া যায়নি 😕';
      results.innerHTML = hits.map((p) => `
        <li class="post-card has-thumb">
          ${p.image
            ? `<a href="/blog/${p.slug}" tabindex="-1" aria-hidden="true"><img class="thumb" src="${p.image}" alt="" loading="lazy" decoding="async" /></a>`
            : `<div class="thumb-fallback" aria-hidden="true"><span>🧪</span></div>`}
          <div class="card-body">
            <a class="title" href="/blog/${p.slug}">${p.title}</a>
            ${p.description ? `<p class="desc">${p.description}</p>` : ''}
            <div class="meta">${p.tags.map((t) => `<span class="tag">#${t}</span>`).join('')}</div>
          </div>
        </li>`).join('');
    });
    // autofocus for UX
    q.focus();
  </script>
</Base>
